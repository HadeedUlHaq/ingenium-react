# Public site URL used for metadata, canonicals, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://wesbite.online

# Supabase project (Settings -> API in the dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Staff passcode for /order and /kds. Defaults to 8008 if unset.
# This is a UI guard, not a security boundary - see lib/gate.ts.
NEXT_PUBLIC_STAFF_CODE=8008
